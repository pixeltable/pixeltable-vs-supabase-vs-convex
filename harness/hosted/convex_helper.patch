export const queryAgent = action({
---
const OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions";

// Same job as the helper in supabase-app: on a hosted model with rate limits, retrying
// and pacing is code the application writes. Retry on 429 and 5xx, honour Retry-After,
// exponential backoff otherwise, six attempts before the request is failed.
async function chatHosted(messages: unknown[]): Promise<{ content: string; attempts: number }> {
  const key = process.env.OPENROUTER_API_KEY;
  if (!key) throw new Error("OPENROUTER_API_KEY is not set");
  const model = process.env.HOSTED_MODEL ?? "nvidia/nemotron-3-super-120b-a12b";
  for (let attempt = 1; attempt <= 6; attempt++) {
    const resp = await fetch(OPENROUTER_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${key}` },
      body: JSON.stringify({ model, messages, max_tokens: 1024, temperature: 0.2 }),
    });
    if (resp.ok) {
      const data = await resp.json();
      const content = data.choices?.[0]?.message?.content;
      // OpenRouter can carry an upstream provider error inside a 200 body; an absent
      // error field and non-empty content are the only shapes worth returning.
      if (!data.error && content) return { content, attempts: attempt };
    } else if (resp.status !== 429 && resp.status < 500) {
      throw new Error(`chat failed: ${resp.status} ${(await resp.text()).slice(0, 200)}`);
    }
    const retryAfter = Number(resp.headers.get("retry-after"));
    const delaySec = Number.isFinite(retryAfter) && retryAfter > 0
      ? retryAfter
      : Math.min(2 ** (attempt - 1) * 2, 30);
    await new Promise((resolve) => setTimeout(resolve, delaySec * 1000));
  }
  throw new Error("chat failed: retries exhausted");
}

