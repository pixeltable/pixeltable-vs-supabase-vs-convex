# Every variable bench.py reads. Copy to ~/shootout.env (mode 600) on the runner; never commit the filled copy.

# Compute targets: each serves targets/fastapi/main.py (or its port) at /docs, /docs/async and /clip.
RAILWAY_URL=https://<service>.up.railway.app
RENDER_URL=https://<service>.onrender.com
VERCEL_URL=https://<project>.vercel.app/api
MODAL_URL=https://<workspace>--pxt-benchmark-fastapi-app.modal.run
CLOUDFLARE_URL=https://<worker>.<subdomain>.workers.dev

# Pixeltable: the service from targets/pixeltable/app.py, an API key, and the docs table's path.
PXT_URL=https://<org>-<db>.svc.pxt.run
PXT_TOKEN=
PXT_DOCS_TABLE=pxt://<org>:<db>/docs

# Databases, each with targets/sql/schema.sql applied (Convex: targets/convex).
NEON_DSN=postgresql://...
NEON_HTTP_ENDPOINT=https://<endpoint>.<region>.aws.neon.tech/sql
TURSO_ENDPOINT=https://<db>-<org>.aws-us-east-1.turso.io/v2/pipeline
TURSO_TOKEN=
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=
CONVEX_URL=https://<deployment>.convex.cloud
RAILWAY_PG_DSN=postgresql://...
RENDER_PG_DSN=postgresql://...
PRISMA_POSTGRES_DSN=postgresql://...

# Optional knobs: SAMPLES (300), LOAD_SECONDS (15), COLD_IDLE_MINUTES (20), MEDIA_VIDEOS (20), SKIP_RESILIENCE.
